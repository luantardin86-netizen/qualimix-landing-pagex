# Qualimix — configuração local
# Copie este arquivo para .env e substitua os valores de exemplo.
# Nunca envie o arquivo .env real para o Git.

NODE_ENV=development
PORT=3001

# PostgreSQL local (Docker Compose)
POSTGRES_PASSWORD=change-me-owner
APP_DB_PASSWORD=change-me-app
DATABASE_URL=postgres://qualimix_app:change-me-app@127.0.0.1:5432/qualimix
DATABASE_MIGRATION_URL=postgres://qualimix_owner:change-me-owner@127.0.0.1:5432/qualimix
DB_POOL_MAX=10

# URL(s) exatas autorizadas a chamar a API pelo navegador.
ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=false

# Segredos locais de desenvolvimento — gere valores fortes para produção.
IP_HASH_SECRET=replace-with-a-long-random-secret
ADMIN_API_TOKEN=replace-with-a-long-random-admin-token

MAX_BODY_BYTES=16384
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=10
RATE_LIMIT_PHONE_PER_DAY=5
RATE_LIMIT_IP_PER_HOUR=20
MIN_FILL_TIME_MS=2500
DUPLICATE_WINDOW_SECONDS=600

# Integração externa com o CRM — manter exclusivamente no backend.
# Vazio = leads permanecem pending_sync e não são enviados.
CRM_API_URL=
CRM_API_TOKEN=
CRM_TIMEOUT_MS=10000
CRM_MAX_ATTEMPTS=8
CRM_SYNC_BATCH_SIZE=20
CRM_SYNC_INTERVAL_MS=60000

# Frontend: vazio usa /api na mesma origem.
VITE_API_BASE_URL=
DEV_API_PROXY_TARGET=http://localhost:3001

# Opcional: servidor PostgreSQL embutido para desenvolvimento sem Docker.
PGLITE_PORT=54329
PGLITE_DATA_DIR=./.pglite-data
