{
  "name": "qualimix-landing-page",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16",
    "lucide-react": "^1.70.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-socket": "^0.2.18",
    "@netlify/database": "^2.0.2",
    "@netlify/functions": "^6.1.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/src/index.ts",
    "build": "vite build",
    "build:api": "esbuild server/src/index.ts server/scripts/migrate.ts server/scripts/crm-sync.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outdir=dist-server --entry-names=[name]",
    "start:api": "node dist-server/index.js",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "tsx server/scripts/migrate.ts",
    "db:dev-pglite": "tsx server/scripts/dev-pglite.ts",
    "crm:sync": "tsx server/scripts/crm-sync.ts"
  }
}
